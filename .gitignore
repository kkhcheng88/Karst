# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# agent runtime output (非記憶,不版控)
.karsai_out/

# Python
__pycache__/
*.pyc
.venv/
venv/

# raw ingested corpora (local reference only; not version-controlled -- can be re-downloaded)
thesis/.raw/gooptions/
thesis/.raw/**/*.jsonl

# Obsidian local workspace state (vault is viewable; per-user config not version-controlled)
thesis/.obsidian/

# SQLite FTS corpus (regenerable from .raw via corpus.py build)
thesis/corpus.db
*.db

# forward-IC snapshot (regenerable)
thesis/ic_report.md

# insider EDGAR cache (regenerable via insider_edgar.py build; slow to fetch)
thesis/insider_cache.json

# SEC bulk Form345 zips for insider backtest (regenerable download)
backtest/.insider_data/

# dashboard scan artifacts (regenerated by web/run_scan.py; live on a VPS volume)
web/data/

# CNN Fear & Greed history (regenerable download, github.com/whit3rabbit/fear-greed-data)
reference/fear_greed/
