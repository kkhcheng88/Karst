# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# agent runtime output (非記憶,不版控)
.karsai_out/

# Python
__pycache__/
*.pyc
.venv/
venv/

# raw ingested corpora (local reference only; not version-controlled -- can be re-downloaded)
thesis/.raw/gooptions/
thesis/.raw/**/*.jsonl

# prefetched earnings-call transcripts (defeatbeta; local raw material for the
# constraint-language scanner -- regenerable via thesis/prefetch_transcripts.py)
thesis/.raw/transcripts/

# full-text extractions of copyrighted ebooks (local reference only for distillation work;
# regenerable from the source PDF -- not version-controlled)
thesis/.raw/*_fulltext.txt

# Obsidian local workspace state (vault is viewable; per-user config not version-controlled)
thesis/.obsidian/

# SQLite FTS corpus (regenerable from .raw via corpus.py build)
thesis/corpus.db
*.db

# forward-IC snapshot (regenerable via forward_ic.py report)
thesis/ic_report.md
thesis/ic_report.json

# track_record one-time migration backups (safety copies, not version-controlled)
thesis/*.jsonl.*.bak
thesis/track_record.jsonl.pre-*.bak

# daily readout / cron runtime logs (regenerated by schtasks jobs)
playbook_log.txt
premarket_log.txt
weekly_risk_log.txt
weekly_valuation_log.txt
*/cron.log
err.log
done

# intermediate backtest data blobs (regenerable by re-running the exp_*.py; results .md are the deliverable)
backtest/experiments/_*.csv
backtest/experiments/_*.json
backtest/experiments/_*.py
backtest/experiments/_*.txt
backtest/experiments/exp_*_output.txt
backtest/results/_*.csv
backtest/results/_scratch_*/

# nightly-analysis runtime log + regenerable sector-lookup cache
thesis/.raw/nightly_analysis.log
thesis/.raw/ticker_sector_cache.json

# constraint_scan.py dedup-state (internal, regenerable from corpus.db re-scan) + cron logs --
# NOTE: thesis/.raw/constraint_scan_queue.md is deliberately NOT listed here -- it's a persistent
# human-triage checklist (same convention as ../Reference's _PENDING_ANALYSIS.md), meant to be
# tracked and survive across sessions.
thesis/.raw/constraint_scan_state.json
thesis/.raw/constraint_scan_cron.log
thesis/.raw/insider_tilt_cron.log
thesis/.raw/altdata_twse_cron.log
thesis/.raw/dashboard_render.log

# magnifier_staleness.py dedup-state (2026-07-12: folded into the daily Karst-nightly-analysis
# guard, no separate cron log -- see thesis/nightly_analysis.log instead). thesis/.raw/
# magnifier_review_queue.md is deliberately NOT listed here, same persistent-checklist
# convention as constraint_scan_queue.md.
thesis/.raw/magnifier_staleness_state.json

# aa_strict_paper_tracker.py state (regenerable by replaying from the start date; the .jsonl
# log is already covered by the thesis/.raw/**/*.jsonl rule above)
thesis/.raw/aa_strict_paper_state.json

backtest/results/*_data.json

# insider EDGAR cache (regenerable via insider_edgar.py build; slow to fetch)
thesis/insider_cache.json

# SEC bulk Form345 zips for insider backtest (regenerable download)
backtest/.insider_data/

# dashboard scan artifacts (regenerated by web/run_scan.py; live on a VPS volume)
web/data/

# CNN Fear & Greed history (regenerable download, github.com/whit3rabbit/fear-greed-data)
reference/fear_greed/

# git worktree tracking origin/main (the curated public-mirror repo) -- dashboard_render.py
# writes/commits/pushes DASHBOARD.md from inside here so the research branch's real history
# never touches the mirror's separate, unrelated history (see thesis/dashboard_render.py docstring)
.dashboard_mirror/

# beta_check.py's cached JSON result (regenerable by re-running beta_check.py; used only so
# dashboard_render.py doesn't have to re-run the (slow) rolling-correlation compute on every render)
thesis/.raw/beta_check_report.json

# paper_ledger.py's regenerable report (target-vs-current gap / kill-VaR / LEAP roll countdown --
# recomputed from thesis/paper_ledger.json + current sizing.py/themes.yaml reads on every
# --update/--report run). NOTE: thesis/paper_ledger.json itself (the ledger's own accumulated
# state) is deliberately NOT listed here -- same "commit the ledger, gitignore the derived report"
# convention as track_record.jsonl vs ic_report.json.
thesis/.raw/paper_ledger_report.json

# data_sentinel.py's freshness-check verdict (regenerable by re-running data_sentinel.py;
# report-only artifact, not a source-of-truth registry -- thesis/.raw/**/*.jsonl above covers
# .jsonl only, this .json needs its own line)
thesis/.raw/data_sentinel.json

# opportunity_ladder.py's regenerable tier + A/B/C/D radar snapshot (report-only, recomputed
# from backtest/data.py VIX/SPY reads on every run -- same "own line per .json" convention as
# beta_check_report.json / data_sentinel.json above)
thesis/.raw/opportunity_ladder.json

# valuation.py's (thesis/valuation.py, v1 production expectations-gap) machine-readable output --
# regenerable by re-running `python thesis/valuation.py --run`; the human-readable deliverable is
# backtest/results/<date>_expectations_gap_v1.md (committed, same convention as v0's .md), same
# "own line per .json" pattern as data_sentinel.json/opportunity_ladder.json above.
thesis/.raw/valuation_report.json

# news_watch.py's (thesis/news_watch.py, narrow-band kill-axis news watcher) regenerable outputs --
# news_watch.json is the daily scan result (re-fetched from Google News RSS on every run);
# news_watch_seen.json is its cross-run dedup state (rolling 14-day window). The keyword CONFIG
# (thesis/news_watch_keywords.yaml) is hand-maintained and IS tracked -- not covered by these lines.
thesis/.raw/news_watch.json
thesis/.raw/news_watch_seen.json
thesis/.raw/news_watch_cron.log

# crowding_composite.py's (thesis/crowding_composite.py, feature-5 magnifier crowding proxy)
# machine-readable output -- regenerable by re-running `python thesis/crowding_composite.py`; the
# human-readable deliverable is backtest/results/<date>_crowding_composite.md (committed), same
# "own line per .json" convention as valuation_report.json/opportunity_ladder.json above.
thesis/.raw/crowding_composite.json

# paper_league.py's (thesis/paper_league.py, unified paper-NAV "league table" across aa-strict /
# spy-bh / sizing-v1 / sizing-v2, 2026-07-13) state + report -- both live under thesis/.raw/ like
# aa_strict_paper_state.json, same gitignored "daily carry-forward working file" convention (state
# is the day-0 baseline + running positions/history; report is regenerable any time via --report).
thesis/.raw/paper_league_state.json
thesis/.raw/paper_league_report.json

# dashboard_render.py's cross-day entry/exit trigger diff state (2026-07-14) -- carry-forward
# working file (last trading day's per-ticker entry/exit state), same convention as the other
# thesis/.raw/*_state.json files above; regenerated/updated automatically each trading day.
thesis/.raw/entry_exit_trigger_state.json

# kill_metrics.py's (P4, docs/2026-07-15_quantification_review.md) regenerable report -- per-theme
# kill-distance buffer / days-to-deadline, recomputed from themes.yaml's kill_metrics: field on every
# --report run. Same "own line per .json" convention as valuation_report.json/crowding_composite.json
# above; themes.yaml's kill_metrics: field itself (the source data) IS tracked, only this derived
# report is gitignored.
thesis/.raw/kill_metrics_report.json

# magnitude_features.py's (P3, docs/2026-07-15_quantification_review.md) regenerable report -- per
# theme/node F2(valuation pctile)/F3(distance-from-5y-bottom)/F5(crowding pctile) + consistency
# flags, recomputed from themes.yaml's nodes: field + thesis/.raw/crowding_composite.json on every
# --report run. Same "own line per .json" convention as kill_metrics_report.json above; themes.yaml
# itself (the source data) IS tracked, only this derived report is gitignored.
thesis/.raw/magnitude_features_report.json
thesis/.raw/zsxq/pdf/

# KOL Discord ledger (backtest/experiments/exp_kol_shunge_ledger.py) -- raw DiscordChatExporter
# extraction, the Nasdaq Trader symbol-universe download, the per-ticker price cache and the
# machine-readable report. ALL regenerable by re-running the exp_ (source JSON lives outside the
# repo at C:\TradingView\Discord\). The committed deliverable is
# backtest/results/2026-07-17_kol_shunge_scorecard.md -- same "intermediates stay in .raw/, the
# .md is the product" convention as the other experiments above.
thesis/.raw/discord/
