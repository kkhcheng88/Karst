              "label",
              "receipt",
              "scenario"
            ]
          }
        },
        "implied": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scenario": {
                  "enum": [
                    "bear",
                    "base",
                    "bull"
                  ]
                },
                "target_price": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "solve_for": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
                },
                "bounds": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "lower",
                    "upper"
                  ]
                },
                "fixed_assumptions": {
                  "$ref": "#/$defs/statement"
                },
                "outcome": {
                  "enum": [
                    "solved",
                    "no_solution",
                    "multiple_solutions",
                    "undefined"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "receipt": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/receipt"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "bounds",
                "fixed_assumptions",
                "outcome",
                "receipt",
                "scenario",
                "solve_for",
                "target_price",
                "value"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alternative_view",
        "change_attribution",
        "expected_distributions",
        "gap_reason",
        "implied",
        "implied_requirements",
        "method_rationale",
        "scenarios",
        "sensitivities",
        "status",
        "target_prices",
        "top_assumptions",
        "valuation_date"
      ]
