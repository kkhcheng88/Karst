    "market": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
