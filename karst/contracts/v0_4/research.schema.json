      "additionalProperties": false,
      "properties": {
        "L1": {
          "$ref": "#/$defs/layer"
        },
        "L2": {
          "$ref": "#/$defs/layer"
        },
        "L3": {
          "$ref": "#/$defs/layer"
        },
        "L4": {
          "$ref": "#/$defs/layer"
        },
        "L5": {
          "$ref": "#/$defs/layer"
        },
        "L6": {
          "$ref": "#/$defs/layer"
        }
      },
      "required": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6"
      ]
    },
