    "strategy_version": {
      "type": "string",
      "minLength": 1
    },
    "mandate_version": {
      "type": "string",
      "minLength": 1
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "researcher",
              "reviewer"
            ]
          },
          "execution": {
            "enum": [
              "interactive",
              "api"
            ]
          }
        },
        "required": [
          "provider",
          "model_id",
          "prompt_version",
          "role",
          "execution"
        ]
      },
      "minItems": 1
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "insufficient"
      ]
    },
    "rating": {
