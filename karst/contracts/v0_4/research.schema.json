            "required": [
              "name",
              "price",
              "rationale"
            ]
          },
          "minItems": 0
        },
        "expected_distributions": {
          "type": "number",
          "minimum": 0
        },
        "sensitivities": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "enum": [
                  "bear",
                  "base",
                  "bull"
