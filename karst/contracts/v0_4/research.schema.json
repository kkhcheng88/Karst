        "citations": {
          "type": "array",
          "items": {
            "$ref": "urn:karst:contract:0.4.0:evidence#/$defs/citation"
          },
          "minItems": 0
        },
        "views": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "D": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bar"
              },
              "minItems": 0
            },
            "W": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bar"
              },
              "minItems": 0
            },
            "M": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bar"
              },
              "minItems": 0
            }
          },
          "required": []
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sma200": {
