      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "$ref": "#/$defs/statement"
        },
        "main_reason": {
          "$ref": "#/$defs/statement"
        },
        "key_assumption": {
          "$ref": "#/$defs/statement"
        },
        "strongest_counter": {
          "$ref": "#/$defs/statement"
        },
        "change_conditions": {
          "$ref": "#/$defs/statement"
        },
        "change_since_last": {
          "$ref": "#/$defs/statement"
        }
      },
      "required": [
        "recommendation",
        "main_reason",
        "key_assumption",
        "strongest_counter",
        "change_conditions",
        "change_since_last"
      ]
    },
    "layers": {
