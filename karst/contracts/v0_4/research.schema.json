                {
                  "type": "null"
                }
              ]
            },
            "bars_count": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "D": {
                  "type": "integer",
                  "minimum": 0
                },
                "W": {
                  "type": "integer",
                  "minimum": 0
                },
                "M": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "D",
                "W",
                "M"
              ]
            },
            "data_as_of": {
              "type": "string",
              "format": "date-time"
