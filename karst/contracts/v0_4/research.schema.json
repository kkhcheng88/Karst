{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:karst:contract:0.4.0:research",
  "title": "Karst research contract 0.4.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
