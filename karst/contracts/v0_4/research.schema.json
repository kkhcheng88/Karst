              },
              "timeframe": {
                "enum": [
                  "D",
                  "W",
                  "M"
                ]
              },
              "lower": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "upper": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "confirmed_at": {
                "type": "string",
                "format": "date-time"
              },
              "rationale": {
                "$ref": "#/$defs/statement"
              }
            },
            "required": [
              "kind",
              "timeframe",
              "lower",
              "upper",
              "confirmed_at",
              "rationale"
            ]
          },
          "minItems": 0
        },
        "reading": {
          "$ref": "#/$defs/statement"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "price_basis",
        "quote_to_bar_factor",
        "citations",
        "derived",
        "key_levels",
        "reading",
        "gaps"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_price": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
