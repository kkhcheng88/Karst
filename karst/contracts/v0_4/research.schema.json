  "required": [
    "contract_version",
    "research_id",
    "packet_id",
    "previous_research_id",
    "created_at",
    "mode",
    "strategy_version",
    "mandate_version",
    "method_version",
    "models",
    "coverage",
    "rating",
    "execution_state",
    "target_date",
    "headline",
    "layers",
    "modules",
    "phases",
    "market",
    "valuation",
    "technical",
    "plan",
    "open_questions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "valuation": {
            "properties": {
              "status": {
                "const": "calculated"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "valuation": {
            "properties": {
              "scenarios": {
                "minItems": 3,
                "maxItems": 3
              },
              "top_assumptions": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "valuation": {
            "properties": {
              "scenarios": {
                "maxItems": 0
              },
              "gap_reason": {
                "type": "string",
                "minLength": 1
              },
              "sensitivities": {
                "maxItems": 0
              },
              "implied": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "insufficient"
          }
        }
      },
      "then": {
        "properties": {
          "rating": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "statement": {
