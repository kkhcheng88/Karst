ev-c46adb2222cdab6d1e5943630bebd66f6486e0b4e256c5e8ac55f273d50a3224"],"kind":"prices","reason":"Supplied source is not truncated; recency and required sections still need review.","status":"available"},{"evidence_ids":["ev-5df8b71530975eec730ceb9c07b419f646fb343e395c99283b200343f0c88425","ev-f4faad140c10d0763c0260a3d556a26b4f50f07b7c25fd6dbc2ce559dfcb0af5"],"kind":"profile","reason":"Supplied source is not truncated; recency and required sections still need review.","status":"available"},{"evidence_ids":["ev-6a90b229272bf9ff9d2d456d040ae85803c609d1517fdd30cbf505688dd1517d","ev-728d56e88325212bdc8affd6b35f13510783cfad44b60a516695e2a660481da4"],"kind":"ratings","reason":"Supplied source is not truncated; recency and required sections still need review.","status":"available"},{"evidence_ids":["ev-f42844fa803db8404d2881c284c003a348e65ea95237175023f0bc684fb5febd"],"kind":"short_interest","reason":"Supplied source is not truncated; recency and required sections still need review.","status":"available"},{"evidence_ids":["ev-a0b0e35c3d883f36040a53083863f30d7a812968a72468495e89e322a75b6b2f","ev-bf111c6fec4cdd4361b8a31fba6ee386b2d471afd69faa086ac945122d183a97"],"kind":"transcript","reason":"Supplied source is not truncated; recency and required sections still need review.","status":"available"}],"security":{"currency":"USD","exchange":"NYSE","issuer_id":"cik:0001664703","name":"Bloom Energy Corp","security_id":"NYSE:BE","ticker":"BE"},"supplement_requests":[{"evidence_ids":[],"layer":"L3","question":"請取回 Bloom Energy 2026 年第二季 10-Q 的關聯方交易附註（Note 11 Related Party Transactions）全文，以及集中風險披露所指「客戶」與會計關聯方定義的對照，用以解釋業績稿所列 Q2'26 關聯方收入 280 萬美元與 10-Q 所列關聯方客戶佔總收入 21% 之間的差異。","reason":"兩份公司文件的同一期間關聯方收入相差近百倍，而公司同期正被沽空機構指控會計問題。此差異若屬定義不同，須落檔說明；若屬實質差異，會改變我對 Q2 收入品質的判斷，並可能把負面評級由估值判斷升級為品質判斷。","request_id":"sr-be-related-party-basis","resolution":null,"status":"pending"},{"evidence_ids":[],"layer":"L3","question":"請取回 Bloom Energy 在 2026 年任何公開場合（業績補充簡報、10-Q、投資者日）披露的最新產品積壓訂單與服務積壓訂單金額及其計算基礎，特別是所含 ITC 等稅務優惠的比重、以及按對手方類別（financier／終端客戶／關聯方）的拆分。","reason":"現有最新數字停留在 2025-12-31，而管理層在 2026 年第二季電話會聲稱積壓增速快過收入卻沒有量化。積壓的規模與對手方分散度是我終值收入假設（2031 年 116 億美元）最直接的證據來源；若積壓大幅重列且對手方分散，基準估值須上調。","request_id":"sr-be-backlog-2026","resolution":null,"status":"pending"},{"evidence_ids":[],"layer":"L2","question":"請取回燃氣輪機與往復式引擎主要廠商（如 GE Vernova、Siemens Energy、Mitsubishi Power、Caterpillar、Cummins）以及其他固態氧化物／熔融碳酸鹽燃料電池廠商的最新產能擴張計劃與交付週期披露，以及資料中心現場發電的行業估值與排名資料。","reason":"「時間換電力的稀缺租金會在終值期被新增供給收回」是本次估值最關鍵而最未核實的假設，現時只能由 Bloom 自述反推。獨立的同業產能與交付期證據若顯示供給到位比我假設更慢，基準終值利潤率須由 22% 上調，基準每股價值會顯著上移。","request_id":"sr-be-peer-supply","resolution":null,"status":"pending"},{"evidence_ids":[],"layer":"L3","question":"請取回 Bloom Energy 2025 年第三季的業績稿全文（8-K 附件 EX-99.1，2025-10-30）及該季電話會逐字稿，以補齊截至 2026 年第二季的連續八季數列。","reason":"本次取證包內 Q3'25 的業績稿雖在允許清單但未實讀，逐字稿亦缺。缺這一季令改善的季度形態（特別是 2025 年下半年由虧轉盈的轉折點）無法完整檢查，影響對改善持續性的判斷而非估值算式。","request_id":"sr-be-q3-2025-quarter","resolution":null,"status":"pending"},{"evidence_ids":[],"layer":"L4","question":"請確認 Longbridge forecast_eps 序列所指的預測期間（是 12 個月前瞻、2026 財年還是 2027 財年）及其覆蓋分析員數目，並補取分項的 2027／2028 財年收入與每股盈利共識及其近三個月修訂方向。","reason":"現時 3.633 美元的中位前瞻每股盈利沒有期間標籤，令倍數對照（73 倍）的口徑不明。確認期間及覆蓋數後，可把成長倍數視角的替代估值由粗估收窄為可核數字，並量度共識修訂方向作為預期差的一手佐證。","request_id":"sr-be-forecast-period-label","resolution":null,"status":"pending"}]}
